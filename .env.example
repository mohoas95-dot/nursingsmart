# PostgreSQL used by Prisma authentication
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nursingsmart?schema=public"

# Initial administrator created by `npm run db:seed`.
AUTH_ADMIN_NATIONAL_ID="0010000003"
AUTH_ADMIN_FIRST_NAME="مدیر"
AUTH_ADMIN_LAST_NAME="سامانه"
# Omit to use the mandated initial password 1234. Change it immediately after login.
AUTH_ADMIN_INITIAL_PASSWORD="1234"

# Session cookie configuration
AUTH_SESSION_HOURS="12"

# ============================================================================
# هوش مصنوعی — معماری ۲۰۲۶ بر پایه Gemini Direct (فقط Gemini)
# - مدل اصلی: gemini-1.5-flash
# - fallback: gemini-1.5-flash (فقط در شرایط جدی: زمان بسیار طولانی، مفهوم نامفهوم، سرور شلوغ)
# - در خطای 503/High Demand، پیش از چرخش کلید ۱ و سپس ۲ ثانیه تلاش مجدد می‌شود
# - اگر هر ۵ تمام شد، مدت انتظار به کاربر در چت‌باکس نشان داده می‌شود
# - سیستم اعتبار ۱۰۰ دلاری حذف شده
# ============================================================================

# --- کلیدهای Gemini (حداقل ۱، توصیه ۵ برای پایداری) ---
GEMINI_API_KEY="AIza_..."
GEMINI_API_KEY_2="AIza_..._2"
GEMINI_API_KEY_3="AIza_..._3"
GEMINI_API_KEY_4="AIza_..._4"
GEMINI_API_KEY_5="AIza_..._5"
# یا به صورت یک متغیر کاما-جدا:
# GEMINI_API_KEYS="AIza_..._1,AIza_..._2,AIza_..._3,AIza_..._4,AIza_..._5"

# --- مدل‌ها (قابل override، پیش‌فرض‌ها طبق درخواست کارفرما) ---
# GEMINI_PRIMARY_MODEL="gemini-1.5-flash"
# GEMINI_FALLBACK_MODEL="gemini-1.5-flash"
# GEMINI_MODEL="gemini-1.5-flash"  # alias قدیمی برای سازگاری

# --- تنظیمات اختیاری Gemini Direct ---
# GEMINI_CALL_TIMEOUT_MS="28000"        # تایم‌اوت هر فراخوانی
# GEMINI_TOTAL_BUDGET_MS="55000"        # بودجه کل هر درخواست (۵ کلید روی ۲ مدل)
# GEMINI_MAX_CALLS_PER_REQUEST="12"     # حداکثر فراخوانی برای هر پیام کاربر
# GEMINI_MAX_OUTPUT_TOKENS="2500"
# GEMINI_TEMPERATURE="0.4"
# خطای 503/High Demand پیش از چرخش کلید، خودکار با تأخیر ۱ و ۲ ثانیه retry می‌شود.

# --- تنظیمات قرنطینه کلیدها (اختیاری) ---
# AI_KEY_QUOTA_COOLDOWN_MS="30000"           # پیش‌فرض ۳۰ ثانیه برای quota دقیقه‌ای
# AI_KEY_QUOTA_COOLDOWN_MAX_MS="300000"      # سقف قرنطینه quota
# AI_KEY_DAILY_QUOTA_COOLDOWN_MS="1800000"   # ۳۰ دقیقه برای daily quota
# AI_KEY_INVALID_COOLDOWN_MS="21600000"      # ۶ ساعت برای کلید نامعتبر
# AI_KEY_BUSY_COOLDOWN_MS="20000"            # ۲۰ ثانیه برای شلوغی سرور

# --- متغیرهای منسوخ شده که باید از Vercel حذف شوند ---
# ❌ OPENROUTER_API_KEY / _2 / _3 / OPENROUTER_API_KEYS
# ❌ OPENROUTER_BASE_URL / OPENROUTER_TEXT_MODEL / OPENROUTER_VISION_MODEL / OPENROUTER_VISION_FALLBACK_MODEL
# ❌ OPENROUTER_HTTP_REFERER / OPENROUTER_APP_TITLE / OPENROUTER_CALL_TIMEOUT_MS و ...
# ❌ GROQ_API_KEY / GROQ_API_KEYS / GROQ_MODEL
# ❌ AI_INITIAL_CREDIT_USD / AI_CREDIT_WARNING_THRESHOLD / AI_CREDIT_CRITICAL_THRESHOLD
# ❌ PRICING_DEEPSEEK_INPUT / PRICING_DEEPSEEK_OUTPUT / PRICING_GPT4O_MINI_* / PRICING_GPT4O_*
# ❌ هر چیزی با پیشوند OPENROUTER_ یا GROQ_ یا PRICING_
