# PostgreSQL used by Prisma authentication
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nursingsmart?schema=public"

# Initial administrator created by `npm run db:seed`.
AUTH_ADMIN_NATIONAL_ID="0010000003"
AUTH_ADMIN_FIRST_NAME="مدیر"
AUTH_ADMIN_LAST_NAME="سامانه"
# Omit to use the mandated initial password 1234. Change it immediately after login.
AUTH_ADMIN_INITIAL_PASSWORD="1234"

# Session cookie configuration
AUTH_SESSION_HOURS="12"

# ============================================================================
# هوش مصنوعی — معماری جدید بر پایه Gemini (جایگزین Groq + Gemini direct + DeepSeek)
# ============================================================================
# متن  → gemini-2.5-flash        (Text Analysis — تحلیل چت، استخراج شیفت‌ها)
# تصویر → gemini-2.5-flash         (Vision / OCR — اسکرین‌شات، جدول شیفت، دست‌نویس)
#         fallback: gemini-3.5-flash (در صورت تحلیل طولانی، مفهوم نامفهوم، شلوغی، مشکل جدی)
#
# کلید اصلی از GEMINI_API_KEY خوانده می‌شود (فایل .env.local)
# برای پایداری از ۵ کلید استفاده می‌شود.
# وضعیت کلیدها را از مسیر GET /api/ai/health ببینید.

# --- Gemini (۵ کلید برای پایداری سیستم) ---
GEMINI_API_KEY="AIza_..."
GEMINI_API_KEY_2="AIza_..._2"
GEMINI_API_KEY_3="AIza_..._3"
GEMINI_API_KEY_4="AIza_..._4"
GEMINI_API_KEY_5="AIza_..._5"

# --- Base URL (اختیاری) ---
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# --- مدل‌ها ---
GEMINI_TEXT_MODEL="gemini-2.5-flash"
GEMINI_TEXT_FALLBACK_MODEL="gemini-3.5-flash"
GEMINI_VISION_MODEL="gemini-2.5-flash"
GEMINI_VISION_FALLBACK_MODEL="gemini-3.5-flash"

# --- تنظیمات اختیاری Gemini ---
# GEMINI_CALL_TIMEOUT_MS="55000"
# GEMINI_TOTAL_BUDGET_MS="110000"
# GEMINI_MAX_CALLS_PER_REQUEST="5"
# GEMINI_MAX_OUTPUT_TOKENS="2000"
# GEMINI_TEMPERATURE="0.4"

# --- قیمت‌گذاری توکن (دلار به ازای هر ۱M توکن) — قابل تنظیم ---
# GEMINI_2_5_FLASH_INPUT="0.001"
# GEMINI_2_5_FLASH_OUTPUT="0.002"
# GEMINI_3_5_FLASH_INPUT="0.002"
# GEMINI_3_5_FLASH_OUTPUT="0.004"

# --- سیستم مدیریت اعتبار ۱۰۰ دلاری ---
# AI_INITIAL_CREDIT_USD="100"
# AI_CREDIT_WARNING_THRESHOLD="15"   # زیر ۱۵ دلار هشدار زرد
# AI_CREDIT_CRITICAL_THRESHOLD="5"   # زیر ۵ دلار هشدار قرمز بحرانی

# --- تنظیمات قدیمی (کاملاً حذف شده — برای سازگاری نگه داشته شده بود) ---
# GROQ_API_KEY="gsk_xxx"
# OPENROUTER_API_KEY="sk-..."
# OPENROUTER_API_KEY_2="sk-..._2"
# OPENROUTER_API_KEY_3="sk-..._3"

# --- تنظیمات عمومی کلیدها ---
# GEMINI_KEY_QUOTA_COOLDOWN_MS="30000"
# GEMINI_KEY_DAILY_QUOTA_COOLDOWN_MS="1800000"
