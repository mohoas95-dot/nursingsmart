# PostgreSQL used by Prisma authentication
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nursingsmart?schema=public"

# Initial administrator created by `npm run db:seed`.
AUTH_ADMIN_NATIONAL_ID="0010000003"
AUTH_ADMIN_FIRST_NAME="مدیر"
AUTH_ADMIN_LAST_NAME="سامانه"
# Omit to use the mandated initial password 1234. Change it immediately after login.
AUTH_ADMIN_INITIAL_PASSWORD="1234"

# Session cookie configuration
AUTH_SESSION_HOURS="12"

# ---------------------------------------------------------------------------
# Hybrid AI architecture (DeepSeek + Gemini Flash)
# ---------------------------------------------------------------------------
# Text chat / structured request parsing -> DeepSeek (deepseek-chat).
# Vision / Persian handwriting OCR       -> Gemini (gemini-2.5-flash).
#
# Each provider supports up to 3 API keys. Requests always try key 1 first;
# on a 429 rate-limit, quota-exceeded error, or any other transient failure,
# the request automatically and transparently rotates to the next key
# (Multi-Key Fallback / Round-Robin) without interrupting the user.
# ---------------------------------------------------------------------------

# DeepSeek Keys (Text Chat)
DEEPSEEK_API_KEY_1=your_key_here
DEEPSEEK_API_KEY_2=your_key_here
DEEPSEEK_API_KEY_3=your_key_here
# Optional overrides:
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini Keys (Vision & Persian Handwriting OCR)
GEMINI_API_KEY_1=your_key_here
GEMINI_API_KEY_2=your_key_here
GEMINI_API_KEY_3=your_key_here
GEMINI_MODEL=gemini-2.5-flash
