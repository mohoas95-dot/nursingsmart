# OPENROUTER_TEXT_FALLBACK_MODEL="deepseek/deepseek-v3"
# OPENROUTER_VISION_MODEL="openai/gpt-4o-mini"
# OPENROUTER_VISION_FALLBACK_MODEL="openai/gpt-4o"

