# PostgreSQL used by Prisma authentication
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nursingsmart?schema=public"

# Initial administrator created by `npm run db:seed`.
AUTH_ADMIN_NATIONAL_ID="0010000003"
AUTH_ADMIN_FIRST_NAME="مدیر"
AUTH_ADMIN_LAST_NAME="سامانه"
# Omit to use the mandated initial password 1234. Change it immediately after login.
AUTH_ADMIN_INITIAL_PASSWORD="1234"

# Session cookie configuration
AUTH_SESSION_HOURS="12"

# ============================================================================
# هوش مصنوعی چت‌باکس — موتور واحد: Puter.js
# ============================================================================
# هم پیام‌های متنی و هم تصاویر از طریق endpoint سازگار با OpenAI روی
# Puter.com پردازش می‌شوند (https://api.puter.com/puterai/openai/v1).
# سهمیهٔ رایگان ماهانهٔ Puter در سطح حساب کاربری محاسبه می‌شود و به‌مراتب
# سخاوتمندانه‌تر از سقف روزانهٔ کلیدهای رایگان سرویس‌های دیگر است.
#
# نحوهٔ گرفتن توکن:
#   ۱. وارد https://puter.com/dashboard#account شوید (یا حساب رایگان بسازید).
#   ۲. در بخش «API token» روی «Create token» بزنید و مقدار را کپی کنید.
#
# می‌توانید تا ۳ توکن (از حساب‌های مختلف Puter) بگذارید. اگر توکن اول به سقف
# سهمیه بخورد سیستم خودکار سراغ دوم و سپس سوم می‌رود.
# وضعیت توکن‌ها را می‌توانید از مسیر GET /api/ai/health ببینید.

PUTER_AUTH_TOKEN="puter_xxx_token_1"
PUTER_AUTH_TOKEN_2="puter_xxx_token_2"
PUTER_AUTH_TOKEN_3="puter_xxx_token_3"

# --- تنظیمات اختیاری (همه پیش‌فرض معقول دارند) ---
# PUTER_MODEL="gpt-5.4-nano"
# PUTER_FALLBACK_MODELS="gpt-5.3-chat,google/gemini-3.5-flash-lite"
# PUTER_VISION_MODEL="gpt-5.4-nano"
# PUTER_VISION_FALLBACK_MODELS="google/gemini-3.5-flash-lite,gpt-5.3-chat"
# PUTER_TEMPERATURE="0.6"
# PUTER_CALL_TIMEOUT_MS="22000"
# PUTER_TOTAL_BUDGET_MS="45000"
# PUTER_MAX_OUTPUT_TOKENS="1500"
# PUTER_MAX_CALLS_PER_REQUEST="4"          # سقف فراخوانی برای هر پیام
# AI_KEY_QUOTA_COOLDOWN_MS="30000"         # قرنطینه پس از سقف دقیقه‌ای
# AI_KEY_DAILY_QUOTA_COOLDOWN_MS="1800000" # قرنطینه پس از سقف روزانه
