# PostgreSQL used by Prisma authentication
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nursingsmart?schema=public"

# Initial administrator created by `npm run db:seed`.
AUTH_ADMIN_NATIONAL_ID="0010000003"
AUTH_ADMIN_FIRST_NAME="مدیر"
AUTH_ADMIN_LAST_NAME="سامانه"
# Omit to use the mandated initial password 1234. Change it immediately after login.
AUTH_ADMIN_INITIAL_PASSWORD="1234"

# Session cookie configuration
AUTH_SESSION_HOURS="12"

# ============================================================================
# هوش مصنوعی — معماری جدید بر پایه OpenRouter (طبق الزامات بازطراحی)
# ============================================================================
# متن  → deepseek/deepseek-chat   (Text Analysis — تحلیل چت، استخراج شیفت‌ها)
# تصویر → openai/gpt-4o-mini       (Vision/OCR — اسکرین‌شات، جدول شیفت، دست‌نویس)
#         fallback: openai/gpt-4o  (در صورت تصویر شلوغ/کم‌کیفیت)
#
# کلید اصلی از OPENROUTER_API_KEY خوانده می‌شود (فایل .env.local)
# برای پایداری می‌توان تا ۳ کلید تعریف کرد: _2 و _3 هم پشتیبانی می‌شوند
# وضعیت کلیدها + اعتبار ۱۰۰ دلاری را از مسیر GET /api/ai/health و /api/ai/credit ببینید.

# --- OpenRouter (کلید اصلی) ---
OPENROUTER_API_KEY="sk-Y2ZCzegXjFInMELyKMZmrxWWYZwAKqmVZCXSSgPbJWkuMOhF"
# OPENROUTER_API_KEY_2="sk-or-v1-xxxx_2"
# OPENROUTER_API_KEY_3="sk-or-v1-xxxx_3"

# --- مدل‌ها (پیش‌فرض‌های مطابق الزام، قابل override) ---
