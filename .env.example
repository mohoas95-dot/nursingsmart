# PostgreSQL used by Prisma authentication
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nursingsmart?schema=public"

# Initial administrator created by `npm run db:seed`.
AUTH_ADMIN_NATIONAL_ID="0010000003"
AUTH_ADMIN_FIRST_NAME="مدیر"
AUTH_ADMIN_LAST_NAME="سامانه"
# Omit to use the mandated initial password 1234. Change it immediately after login.
AUTH_ADMIN_INITIAL_PASSWORD="1234"

# Session cookie configuration
AUTH_SESSION_HOURS="12"

# ============================================================================
# هوش مصنوعی چت‌باکس — دو موتور کاملاً مستقل
# ============================================================================
# متن  → Groq   (Llama 3.3 70B) — سریع، رایگان، سهمیهٔ روزانهٔ بالا
# تصویر → Gemini (2.5 Flash)    — OCR فارسی دقیق با مصرف کریدیت کم
#
# برای هر سرویس تا ۳ کلید رایگان بگذارید. اگر کلید اول به سقف سهمیه بخورد
# (۴۲۹ / quota) سیستم خودکار سراغ دوم و سپس سوم می‌رود. سهمیهٔ این دو سرویس
# هیچ اشتراکی با هم ندارند.
# وضعیت کلیدها را می‌توانید از مسیر GET /api/ai/health ببینید.

# --- Groq: فقط پیام‌های متنی ---
GROQ_API_KEY="gsk_xxx_key_1"
GROQ_API_KEY_2="gsk_xxx_key_2"
GROQ_API_KEY_3="gsk_xxx_key_3"

# --- Gemini: فقط تصاویر ---
GEMINI_API_KEY="AIza_xxx_key_1"
GEMINI_API_KEY_2="AIza_xxx_key_2"
GEMINI_API_KEY_3="AIza_xxx_key_3"

# --- تنظیمات اختیاری (همه پیش‌فرض معقول دارند) ---
# GROQ_MODEL="llama-3.3-70b-versatile"
# GROQ_FALLBACK_MODELS="llama-3.1-8b-instant,openai/gpt-oss-20b"
# GROQ_CALL_TIMEOUT_MS="20000"
# GROQ_TOTAL_BUDGET_MS="42000"
# GEMINI_VISION_MODEL="gemini-2.5-flash"
# GEMINI_VISION_FALLBACK_MODELS="gemini-2.5-flash-lite,gemini-2.0-flash"
# GEMINI_CALL_TIMEOUT_MS="24000"
# GEMINI_TOTAL_BUDGET_MS="48000"
# AI_KEY_QUOTA_COOLDOWN_MS="600000"
