# PostgreSQL used by Prisma authentication
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nursingsmart?schema=public"

# Initial administrator created by `npm run db:seed`.
AUTH_ADMIN_NATIONAL_ID="0010000003"
AUTH_ADMIN_FIRST_NAME="مدیر"
AUTH_ADMIN_LAST_NAME="سامانه"
# Omit to use the mandated initial password 1234. Change it immediately after login.
AUTH_ADMIN_INITIAL_PASSWORD="1234"

# Session cookie configuration
AUTH_SESSION_HOURS="12"

# ── Object Storage (S3-compatible — ArvanCloud etc.) ─────────────────────────
# دادهٔ اصلی (پرسنل، درخواست‌ها، برنامه‌ها) در Object Storage نگهداری می‌شود.
# ⚠️ بدون این متغیرها صفحهٔ اصلی بعد از ورود خالی می‌ماند (خطای STORAGE_UNAVAILABLE).
# STORAGE_ENV مقدار پیش‌فرض ندارد و باید صریحاً development/staging/production باشد.
STORAGE_ENV="development"
S3_ENDPOINT="https://s3.ir-thr-at1.arvanstorage.ir"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# هر محیط سطل جداگانه دارد؛ فقط سطلِ متناظر با STORAGE_ENV استفاده می‌شود.
S3_BUCKET_DEVELOPMENT="nursingsmart-development"
S3_BUCKET_STAGING="nursingsmart-staging"
S3_BUCKET_PRODUCTION="nursingsmart-production"

# ── عیب‌یابی ────────────────────────────────────────────────────────────────
#   STORAGE_ENV=development npm run storage:check       ← بررسی کامل سطل
#   STORAGE_ENV=development npm run storage:migrate:s3  ← مهاجرت snapshot قدیمی داخل سطل
