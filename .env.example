# PostgreSQL used by Prisma authentication
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nursingsmart?schema=public"

# Initial administrator created by `npm run db:seed`.
AUTH_ADMIN_NATIONAL_ID="0010000003"
AUTH_ADMIN_FIRST_NAME="مدیر"
AUTH_ADMIN_LAST_NAME="سامانه"
# Omit to use the mandated initial password 1234. Change it immediately after login.
AUTH_ADMIN_INITIAL_PASSWORD="1234"

# Session cookie configuration
AUTH_SESSION_HOURS="12"

# Google Gemini API integration used by the smart request chatbox.
# The public Gemini app has separate routing/quota; this project uses these API models directly.
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODELS="gemini-2.0-flash,gemini-2.5-flash-lite,gemini-2.0-flash-lite"
GEMINI_VISION_MODEL="gemini-2.5-flash"
GEMINI_VISION_FALLBACK_MODELS="gemini-2.0-flash,gemini-2.5-flash-lite"
# Optional tuning
GEMINI_ATTEMPTS_PER_MODEL="2"
GEMINI_TOTAL_BUDGET_MS="34000"
GEMINI_VISION_TOTAL_BUDGET_MS="52000"
GEMINI_CALL_TIMEOUT_MS="16000"
GEMINI_VISION_CALL_TIMEOUT_MS="24000"
GEMINI_THINKING_LEVEL="off"
